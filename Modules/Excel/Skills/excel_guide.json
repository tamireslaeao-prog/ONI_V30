    "essential_formulas": {
        "mathematical": {
            "SUM": {
                "syntax": "=SUM(number1, [number2], ...)",
                "example": "=SUM(A1:A10)",
                "description": "Soma valores em um intervalo",
                "category": "math"
            },
            "AVERAGE": {
                "syntax": "=AVERAGE(number1, [number2], ...)",
                "example": "=AVERAGE(A1:A10)",
                "description": "Calcula a média aritmética",
                "category": "math"
            },
            "COUNT": {
                "syntax": "=COUNT(value1, [value2], ...)",
                "example": "=COUNT(A1:A10)",
                "description": "Conta células com números",
                "category": "math"
            },
            "COUNTA": {
                "syntax": "=COUNTA(value1, [value2], ...)",
                "example": "=COUNTA(A1:A10)",
                "description": "Conta células não vazias",
                "category": "math"
            },
            "MAX": {
                "syntax": "=MAX(number1, [number2], ...)",
                "example": "=MAX(A1:A10)",
                "description": "Retorna o maior valor",
                "category": "math"
            },
            "MIN": {
                "syntax": "=MIN(number1, [number2], ...)",
                "example": "=MIN(A1:A10)",
                "description": "Retorna o menor valor",
                "category": "math"
            },
            "ROUND": {
                "syntax": "=ROUND(number, num_digits)",
                "example": "=ROUND(A1, 2)",
                "description": "Arredonda número para dígitos especificados",
                "category": "math"
            },
            "SUMIF": {
                "syntax": "=SUMIF(range, criteria, [sum_range])",
                "example": "=SUMIF(A1:A10, \">100\", B1:B10)",
                "description": "Soma células que atendem critério",
                "category": "math"
            },
            "SUMIFS": {
                "syntax": "=SUMIFS(sum_range, criteria_range1, criteria1, ...)",
                "example": "=SUMIFS(C1:C10, A1:A10, \"Sul\", B1:B10, \">100\")",
                "description": "Soma com múltiplos critérios",
                "category": "math"
            },
            "COUNTIF": {
                "syntax": "=COUNTIF(range, criteria)",
                "example": "=COUNTIF(A1:A10, \">50\")",
                "description": "Conta células que atendem critério",
                "category": "math"
            }
        },
        "logical": {
            "IF": {
                "syntax": "=IF(logical_test, value_if_true, value_if_false)",
                "example": "=IF(A1>100, \"Alto\", \"Baixo\")",
                "description": "Teste lógico condicional",
                "category": "logical"
            },
            "AND": {
                "syntax": "=AND(logical1, [logical2], ...)",
                "example": "=AND(A1>50, B1<100)",
                "description": "Retorna TRUE se todos forem verdadeiros",
                "category": "logical"
            },
            "OR": {
                "syntax": "=OR(logical1, [logical2], ...)",
                "example": "=OR(A1>100, B1>100)",
                "description": "Retorna TRUE se algum for verdadeiro",
                "category": "logical"
            },
            "NOT": {
                "syntax": "=NOT(logical)",
                "example": "=NOT(A1>100)",
                "description": "Inverte o valor lógico",
                "category": "logical"
            },
            "IFS": {
                "syntax": "=IFS(logical_test1, value1, [logical_test2, value2], ...)",
                "example": "=IFS(A1>100, \"Alto\", A1>50, \"Médio\", TRUE, \"Baixo\")",
                "description": "Múltiplas condições IF",
                "category": "logical"
            },
            "IFERROR": {
                "syntax": "=IFERROR(value, value_if_error)",
                "example": "=IFERROR(A1/B1, 0)",
                "description": "Retorna valor alternativo se erro",
                "category": "logical"
            }
        },
        "lookup_reference": {
            "VLOOKUP": {
                "syntax": "=VLOOKUP(lookup_value, table_array, col_index_num, [range_lookup])",
                "example": "=VLOOKUP(A1, D1:F10, 3, FALSE)",
                "description": "Procura valor verticalmente em tabela",
                "category": "lookup",
                "tips": "Use FALSE para correspondência exata"
            },
            "HLOOKUP": {
                "syntax": "=HLOOKUP(lookup_value, table_array, row_index_num, [range_lookup])",
                "example": "=HLOOKUP(A1, A1:Z5, 3, FALSE)",
                "description": "Procura valor horizontalmente",
                "category": "lookup"
            },
            "XLOOKUP": {
                "syntax": "=XLOOKUP(lookup_value, lookup_array, return_array, [if_not_found], [match_mode], [search_mode])",
                "example": "=XLOOKUP(A1, B1:B10, C1:C10)",
                "description": "Procura moderna e flexível (Excel 365)",
                "category": "lookup",
                "advantages": "Mais poderoso que VLOOKUP"
            },
            "INDEX": {
                "syntax": "=INDEX(array, row_num, [column_num])",
                "example": "=INDEX(A1:C10, 5, 2)",
                "description": "Retorna valor em posição específica",
                "category": "lookup"
            },
            "MATCH": {
                "syntax": "=MATCH(lookup_value, lookup_array, [match_type])",
                "example": "=MATCH(\"João\", A1:A10, 0)",
                "description": "Retorna posição de valor em intervalo",
                "category": "lookup"
            },
            "INDEX_MATCH": {
                "syntax": "=INDEX(return_range, MATCH(lookup_value, lookup_range, 0))",
                "example": "=INDEX(C1:C10, MATCH(A1, B1:B10, 0))",
                "description": "Combinação poderosa INDEX + MATCH",
                "category": "lookup",
                "advantages": "Mais flexível que VLOOKUP"
            },
            "OFFSET": {
                "syntax": "=OFFSET(reference, rows, cols, [height], [width])",
                "example": "=OFFSET(A1, 2, 3, 1, 1)",
                "description": "Retorna referência deslocada",
                "category": "lookup"
            }
        },
        "text": {
            "CONCATENATE": {
                "syntax": "=CONCATENATE(text1, [text2], ...)",
                "example": "=CONCATENATE(A1, \" \", B1)",
                "description": "Junta textos",
                "category": "text",
                "alternative": "Use & ou CONCAT"
            },
            "CONCAT": {
                "syntax": "=CONCAT(text1, [text2], ...)",
                "example": "=CONCAT(A1:A10)",
                "description": "Concatena intervalo (Excel 2019+)",
                "category": "text"
            },
            "TEXTJOIN": {
                "syntax": "=TEXTJOIN(delimiter, ignore_empty, text1, [text2], ...)",
                "example": "=TEXTJOIN(\", \", TRUE, A1:A10)",
                "description": "Junta com delimitador",
                "category": "text"
            },
            "LEFT": {
                "syntax": "=LEFT(text, [num_chars])",
                "example": "=LEFT(A1, 5)",
                "description": "Retorna caracteres à esquerda",
                "category": "text"
            },
            "RIGHT": {
                "syntax": "=RIGHT(text, [num_chars])",
                "example": "=RIGHT(A1, 5)",
                "description": "Retorna caracteres à direita",
                "category": "text"
            },
            "MID": {
                "syntax": "=MID(text, start_num, num_chars)",
                "example": "=MID(A1, 3, 5)",
                "description": "Extrai texto do meio",
                "category": "text"
            },
            "LEN": {
                "syntax": "=LEN(text)",
                "example": "=LEN(A1)",
                "description": "Retorna comprimento do texto",
                "category": "text"
            },
            "TRIM": {
                "syntax": "=TRIM(text)",
                "example": "=TRIM(A1)",
                "description": "Remove espaços extras",
                "category": "text"
            },
            "UPPER": {
                "syntax": "=UPPER(text)",
                "example": "=UPPER(A1)",
                "description": "Converte para maiúsculas",
                "category": "text"
            },
            "LOWER": {
                "syntax": "=LOWER(text)",
                "example": "=LOWER(A1)",
                "description": "Converte para minúsculas",
                "category": "text"
            },
            "PROPER": {
                "syntax": "=PROPER(text)",
                "example": "=PROPER(A1)",
                "description": "Capitaliza cada palavra",
                "category": "text"
            }
        },
        "date_time": {
            "TODAY": {
                "syntax": "=TODAY()",
                "example": "=TODAY()",
                "description": "Retorna data atual",
                "category": "date"
            },
            "NOW": {
                "syntax": "=NOW()",
                "example": "=NOW()",
                "description": "Retorna data e hora atuais",
                "category": "date"
            },
            "DATE": {
                "syntax": "=DATE(year, month, day)",
                "example": "=DATE(2025, 12, 31)",
                "description": "Cria data a partir de componentes",
                "category": "date"
            },
            "YEAR": {
                "syntax": "=YEAR(serial_number)",
                "example": "=YEAR(A1)",
                "description": "Extrai ano de data",
                "category": "date"
            },
            "MONTH": {
                "syntax": "=MONTH(serial_number)",
                "example": "=MONTH(A1)",
                "description": "Extrai mês de data",
                "category": "date"
            },
            "DAY": {
                "syntax": "=DAY(serial_number)",
                "example": "=DAY(A1)",
                "description": "Extrai dia de data",
                "category": "date"
            },
            "WEEKDAY": {
                "syntax": "=WEEKDAY(serial_number, [return_type])",
                "example": "=WEEKDAY(A1, 2)",
                "description": "Retorna dia da semana (1-7)",
                "category": "date"
            },
            "EOMONTH": {
                "syntax": "=EOMONTH(start_date, months)",
                "example": "=EOMONTH(A1, 0)",
                "description": "Retorna último dia do mês",
                "category": "date"
            },
            "DATEDIF": {
                "syntax": "=DATEDIF(start_date, end_date, unit)",
                "example": "=DATEDIF(A1, B1, \"Y\")",
                "description": "Calcula diferença entre datas",
                "category": "date",
                "units": "Y=anos, M=meses, D=dias"
            },
            "NETWORKDAYS": {
                "syntax": "=NETWORKDAYS(start_date, end_date, [holidays])",
                "example": "=NETWORKDAYS(A1, B1)",
                "description": "Dias úteis entre datas",
                "category": "date"
            }
        },
        "statistical": {
            "MEDIAN": {
                "syntax": "=MEDIAN(number1, [number2], ...)",
                "example": "=MEDIAN(A1:A10)",
                "description": "Retorna mediana",
                "category": "stats"
            },
            "MODE": {
                "syntax": "=MODE.SNGL(number1, [number2], ...)",
                "example": "=MODE.SNGL(A1:A10)",
                "description": "Valor mais frequente",
                "category": "stats"
            },
            "STDEV": {
                "syntax": "=STDEV.S(number1, [number2], ...)",
                "example": "=STDEV.S(A1:A10)",
                "description": "Desvio padrão (amostra)",
                "category": "stats"
            },
            "VAR": {
                "syntax": "=VAR.S(number1, [number2], ...)",
                "example": "=VAR.S(A1:A10)",
                "description": "Variância (amostra)",
                "category": "stats"
            },
            "RANK": {
                "syntax": "=RANK.EQ(number, ref, [order])",
                "example": "=RANK.EQ(A1, A$1:A$10, 0)",
                "description": "Classificação de valor",
                "category": "stats"
            },
            "PERCENTILE": {
                "syntax": "=PERCENTILE.INC(array, k)",
                "example": "=PERCENTILE.INC(A1:A10, 0.9)",
                "description": "Percentil de conjunto",
                "category": "stats"
            }
        },
        "financial": {
            "PMT": {
                "syntax": "=PMT(rate, nper, pv, [fv], [type])",
                "example": "=PMT(5%/12, 60, -10000)",
                "description": "Calcula pagamento de empréstimo",
                "category": "financial"
            },
            "FV": {
                "syntax": "=FV(rate, nper, pmt, [pv], [type])",
                "example": "=FV(6%/12, 120, -100, 0, 0)",
                "description": "Valor futuro de investimento",
                "category": "financial"
            },
            "PV": {
                "syntax": "=PV(rate, nper, pmt, [fv], [type])",
                "example": "=PV(8%/12, 120, -100)",
                "description": "Valor presente",
                "category": "financial"
            },
            "NPV": {
                "syntax": "=NPV(rate, value1, [value2], ...)",
                "example": "=NPV(10%, A1:A10)",
                "description": "Valor presente líquido",
                "category": "financial"
            },
            "IRR": {
                "syntax": "=IRR(values, [guess])",
                "example": "=IRR(A1:A10)",
                "description": "Taxa interna de retorno",
                "category": "financial"
            }
        }
    },
