    "pre_drawing_checklist": [
        {
            "check": "brush_size",
            "prompt": "Verifique o tamanho do pincel no topo da tela",
            "expected": "Tamanho entre 2-10px para desenho de linhas",
            "fix_if_wrong": "Pressione [ várias vezes para diminuir",
            "importance": "critical",
            "verification": "Olhe na barra de opções superior"
        },
        {
            "check": "foreground_color",
            "prompt": "Verifique a cor de foreground no painel de ferramentas",
            "expected": "Cor escura para linhas (preto ideal)",
            "fix_if_wrong": "Pressione D para cores default, ou clique na cor",
            "importance": "critical",
            "verification": "Quadrado frontal no seletor de cores"
        },
        {
            "check": "active_tool",
            "prompt": "Verifique qual ferramenta está ativa",
            "expected": "Brush Tool selecionado",
            "fix_if_wrong": "Pressione B para selecionar pincel",
            "importance": "critical",
            "verification": "Ícone destacado na barra de ferramentas"
        },
        {
            "check": "layer",
            "prompt": "Verifique se há camada ativa no painel Layers",
            "expected": "Uma camada selecionada (não Background bloqueado)",
            "fix_if_wrong": "Clique na camada ou crie nova com Ctrl+Shift+N",
            "importance": "critical",
            "verification": "Camada destacada no painel Layers"
        },
        {
            "check": "brush_hardness",
            "prompt": "Verifique a dureza do pincel",
            "expected": "80-100% para linhas nítidas",
            "fix_if_wrong": "Ajuste na barra de opções ou pressione { ou }",
            "importance": "high",
            "verification": "Valor de Hardness na barra superior"
        },
        {
            "check": "opacity",
            "prompt": "Verifique a opacidade do pincel",
            "expected": "100% para linhas sólidas",
            "fix_if_wrong": "Digite '0' (zero) ou ajuste no slider",
            "importance": "high",
            "verification": "Valor de Opacity na barra superior"
        },
        {
            "check": "flow",
            "prompt": "Verifique o flow do pincel",
            "expected": "100% para aplicação consistente",
            "fix_if_wrong": "Ajuste no slider de Flow",
            "importance": "medium",
            "verification": "Valor de Flow na barra superior"
        },
        {
            "check": "canvas_resolution",
            "prompt": "Verifique a resolução do canvas",
            "expected": "Mínimo 300 DPI para trabalho profissional",
            "fix_if_wrong": "Image > Image Size para ajustar",
            "importance": "high",
            "verification": "Visível no canto inferior esquerdo"
        },
        {
            "check": "color_mode",
            "prompt": "Verifique o modo de cor do documento",
            "expected": "RGB para tela, CMYK para impressão",
            "fix_if_wrong": "Image > Mode > escolha o modo correto",
            "importance": "medium",
            "verification": "Título da janela mostra o modo"
        },
        {
            "check": "rulers_guides",
            "prompt": "Verifique se réguas estão visíveis se necessário",
            "expected": "Réguas ativas para trabalho com precisão",
            "fix_if_wrong": "Pressione Ctrl+R para mostrar/ocultar",
            "importance": "low",
            "verification": "Réguas nas bordas do canvas"
        }
    ],
