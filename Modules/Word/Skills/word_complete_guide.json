    "pre_writing_checklist": [
        {
            "check": "page_setup",
            "prompt": "Verificar configurações de página",
            "expected": "Tamanho, orientação e margens corretas",
            "fix_if_wrong": "Layout > Size/Margins",
            "importance": "critical",
            "verification": "Layout tab mostra configurações"
        },
        {
            "check": "language",
            "prompt": "Verificar idioma do documento",
            "expected": "Português (Brasil) ou conforme necessário",
            "fix_if_wrong": "Review > Language > Set Proofing Language",
            "importance": "critical",
            "verification": "Barra de status mostra idioma"
        },
        {
            "check": "styles",
            "prompt": "Configurar estilos antes de começar",
            "expected": "Normal, Heading 1-3 configurados",
            "fix_if_wrong": "Home > Styles > Modify",
            "importance": "high",
            "verification": "Styles pane mostra estilos disponíveis"
        },
        {
            "check": "autocorrect",
            "prompt": "Verificar configurações de autocorreção",
            "expected": "AutoCorrect ativo, configurações apropriadas",
            "fix_if_wrong": "File > Options > Proofing > AutoCorrect Options",
            "importance": "medium",
            "verification": "Teste digitando"
        },
        {
            "check": "track_changes",
            "prompt": "Verificar se Track Changes está apropriado",
            "expected": "Ativo para revisão, inativo para escrita",
            "fix_if_wrong": "Ctrl+Shift+E",
            "importance": "high",
            "verification": "Review tab mostra status"
        },
        {
            "check": "autosave",
            "prompt": "Verificar AutoSave/AutoRecover",
            "expected": "AutoSave ativo, intervalo de 10 minutos",
            "fix_if_wrong": "File > Options > Save",
            "importance": "critical",
            "verification": "Barra de título mostra AutoSave status"
        },
        {
            "check": "zoom",
            "prompt": "Ajustar zoom para conforto visual",
            "expected": "100-125% dependendo do monitor",
            "fix_if_wrong": "View > Zoom ou slider inferior",
            "importance": "medium",
            "verification": "Canto inferior direito mostra zoom"
        },
        {
            "check": "show_formatting",
            "prompt": "Decidir se mostra marcas de formatação",
            "expected": "Ativo para edição precisa",
            "fix_if_wrong": "Ctrl+Shift+8 ou Home > Show/Hide",
            "importance": "medium",
            "verification": "Marcas de parágrafo visíveis"
        },
        {
            "check": "rulers_gridlines",
            "prompt": "Ativar réguas se necessário",
            "expected": "Réguas visíveis para alinhamento preciso",
            "fix_if_wrong": "View > Ruler",
            "importance": "low",
            "verification": "Réguas nas bordas do documento"
        },
        {
            "check": "default_font",
            "prompt": "Verificar fonte padrão",
            "expected": "Fonte apropriada para o documento",
            "fix_if_wrong": "Home > Font dialog > Set as Default",
            "importance": "medium",
            "verification": "Fonte mostrada na barra de ferramentas"
        }
    ],
