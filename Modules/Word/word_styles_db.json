  "macros_vba": {
    "insert_timestamp": "Sub InsertTimestamp()\nSelection.TypeText Format(Now, \"mmmm dd, yyyy\")\nEnd Sub",
    
    "apply_corporate_header": "Sub ApplyCorporateHeader()\nActiveDocument.Sections(1).Headers(1).Range.Text = \"Company Name\"\nEnd Sub",
    
    "format_table": "Sub FormatTable()\nSelection.Tables(1).AutoFormat Format:=wdTableFormatGrid4\nEnd Sub"
  }
