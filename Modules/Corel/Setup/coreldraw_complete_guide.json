    "pre_design_checklist": [
        {
            "check": "page_setup",
            "prompt": "Verifique o tamanho e orientação da página",
            "expected": "Tamanho correto para o projeto",
            "fix_if_wrong": "Layout > Page Setup ou duplo-clique na página",
            "importance": "critical",
            "verification": "Canto inferior esquerdo mostra dimensões"
        },
        {
            "check": "color_mode",
            "prompt": "Verifique o modo de cor do documento",
            "expected": "RGB para digital, CMYK para impressão",
            "fix_if_wrong": "Tools > Color Management",
            "importance": "critical",
            "verification": "Barra de status mostra modo"
        },
        {
            "check": "units",
            "prompt": "Verifique as unidades de medida",
            "expected": "mm para impressão, pixels para web",
            "fix_if_wrong": "Tools > Options > Workspace > Rulers",
            "importance": "high",
            "verification": "Réguas mostram unidades"
        },
        {
            "check": "grid_guides",
            "prompt": "Configure grid e guias se necessário",
            "expected": "Grid visível e snap ativo para precisão",
            "fix_if_wrong": "View > Grid/Guides, Alt+Z para snap",
            "importance": "medium",
            "verification": "Grid visível no canvas"
        },
        {
            "check": "snap_settings",
            "prompt": "Verifique configurações de snap",
            "expected": "Snap to Objects ativo (Alt+Z)",
            "fix_if_wrong": "View > Snap To > Objects",
            "importance": "high",
            "verification": "Ícone snap na barra de ferramentas"
        },
        {
            "check": "color_palette",
            "prompt": "Verifique se paleta de cores está visível",
            "expected": "Paleta CMYK ou RGB visível",
            "fix_if_wrong": "Window > Color Palettes",
            "importance": "medium",
            "verification": "Paleta no lado direito da tela"
        },
        {
            "check": "outline_width",
            "prompt": "Verifique espessura padrão de contorno",
            "expected": "Hairline ou 0.5mm para trabalho inicial",
            "fix_if_wrong": "F12 para ajustar outline pen",
            "importance": "medium",
            "verification": "Barra de propriedades mostra espessura"
        },
        {
            "check": "bleed_area",
            "prompt": "Configure área de sangria se for imprimir",
            "expected": "3-5mm de bleed configurado",
            "fix_if_wrong": "Layout > Page Setup > Bleed",
            "importance": "high",
            "verification": "Área de bleed visível no canvas"
        },
        {
            "check": "resolution_export",
            "prompt": "Defina resolução para exportação",
            "expected": "300 DPI para impressão",
            "fix_if_wrong": "File > Export > Settings",
            "importance": "medium",
            "verification": "Configurar antes de exportar"
        },
        {
            "check": "backup_autosave",
            "prompt": "Verifique se autosave está ativo",
            "expected": "Salvar automaticamente a cada 10 minutos",
            "fix_if_wrong": "Tools > Options > Workspace > Save",
            "importance": "high",
            "verification": "Configurações de autosave ativas"
        }
    ],
    
