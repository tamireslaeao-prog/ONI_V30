            "ease": "ease_out"
          }
        }
      },
      
      "animation_presets": {
        "simple_fade": {
          "duration": 0.8,
          "opacity": [0, 100],
          "easing": "ease_out"
        },
        
        "subtle_scale": {
          "duration": 1.0,
          "scale": [[95, 95], [100, 100]],
          "easing": "ease_out"
        }
      },
      
      "effects_library": {
        "drop_shadow": {
          "effect": "ADBE Drop Shadow",
          "distance": 5,
          "softness": 15,
          "opacity": 0.3
        }
      }
    },
    
    {
      "style_id": "synthwave_motion_v1",
      "name": "Synthwave Retro Motion",
      "description": "80s inspired motion graphics with gradients and grids",
      "version": "1.0",
      
      "composition": {
        "default_size": [1920, 1080],
        "frame_rate": 30,
        "duration": 12
      },
      
      "color_system": {
        "mode": "RGB",
        "gradient_pairs": [
          ["#FF006E", "#8338EC"],
          ["#FB5607", "#FFBE0B"],
          ["#3A86FF", "#06FFA5"]
        ]
      },
      
      "effects_library": {
        "gradient_ramp": {
          "effect": "ADBE Ramp",
          "start_color": [1.0, 0, 0.431],
          "end_color": [0.514, 0.220, 0.925],
          "ramp_shape": "linear"
        },
        
        "cc_light_sweep": {
          "effect": "CC Light Sweep",
          "direction": 90,
          "width": 50,
          "edge_intensity": 75
        }
      },
      
      "animation_presets": {
        "grid_reveal": {
          "duration": 2.0,
          "method": "perspective_reveal",
          "vanishing_point": "bottom_center"
        }
      }
    },
    
    {
      "style_id": "glitch_art_v1",
      "name": "Digital Glitch Art",
      "description": "Data corruption aesthetics with displacement and channel shifts",
      "version": "1.0",
      
      "effects_library": {
        "glitch_combo": [
          {
            "effect": "ADBE Displacement Map",
            "expression": "wiggle(10, 50)"
          },
          {
            "effect": "ADBE Channel Mixer",
            "red_channels": [1, 0.1, 0],
            "blue_channels": [0, 0.1, 1]
          },
          {
            "effect": "ADBE Block Dissolve",
            "block_width": 20,
            "block_height": 20
          }
        ],
        
        "datamosh": {
          "method": "posterize_time",
          "frame_rate": 12,
          "echo": true
        }
      }
    },
    
    {
      "style_id": "kinetic_typography_v1",
      "name": "Kinetic Typography",
      "description": "Dynamic text animations with rhythm and energy",
      "version": "1.0",
      
      "typography_ae": {
        "animator_properties": [
          {
            "name": "Position Wiggle",
            "property": "position",
            "expression": "wiggle(4, 20)"
          },
          {
            "name": "Scale Bounce",
            "property": "scale",
            "keyframes": "bounce_pattern"
          },
          {
            "name": "Rotation Spin",
            "property": "rotation",
            "expression": "time * 360"
          }
        ],
        
        "range_selector": {
          "based_on": "characters",
          "start": 0,
          "end": 100,
          "offset": 0,
          "ease_high": 50,
          "ease_low": 50
        }
      }
    },
    
    {
      "style_id": "infographic_motion_v1",
      "name": "Infographic Data Viz",
      "description": "Animated charts, graphs and data visualization",
      "version": "1.0",
      
      "chart_types": {
        "bar_chart": {
          "method": "shape_layers",
          "animation": "sequential_reveal",
          "duration_per_bar": 0.3
        },
        
        "line_chart": {
          "method": "stroke_animation",
          "trim_paths": true,
          "duration": 2.0
        },
        
        "pie_chart": {
          "method": "mask_reveal",
          "rotation": "clockwise",
          "duration": 1.5
        }
      },
      
      "number_counters": {
        "effect": "ADBE Numbers",
        "expression": "linear(time, 0, 2, 0, targetValue)",
        "format": "integer",
        "comma_separator": true
      }
    }
  ],
  
  "global_ae_settings": {
    "project_settings": {
      "color_depth": "16_bits",
      "linearize_working_space": false,
      "preserve_rgb": true
    },
    
    "composition_defaults": {
      "width": 1920,
      "height": 1080,
      "pixel_aspect": 1.0,
      "frame_rate": 30,
      "duration": 10,
      "resolution": "full"
    },
    
    "render_settings": {
      "best_quality": true,
      "motion_blur": false,
      "frame_blending": false,
      "field_render": "off"
    },
    
    "output_modules": {
      "preview": {
        "format": "H.264",
        "preset": "Match Render Settings - 15 Mbps"
      },
      "final": {
        "format": "QuickTime",
        "codec": "Apple ProRes 422 HQ",
        "audio": false
      },
      "web": {
        "format": "H.264",
        "preset": "YouTube 1080p HD",
        "max_bitrate": 20
      }
    }
  },
  
  "expressions_library": {
    "wiggle_smooth": "freq = 2; amp = 50; smooth = 5; wiggle(freq, amp).smooth(smooth)",
    
    "bounce": "amp = .1; freq = 2.0; decay = 5.0; n = 0; if (numKeys > 0){n = nearestKey(time).index; if (key(n).time > time){n--;}} if (n == 0){ t = 0;} else {t = time - key(n).time;} if (n > 0){v = velocityAtTime(key(n).time - thisComp.frameDuration/10); value + v*amp*Math.sin(freq*t*2*Math.PI)/Math.exp(decay*t);} else {value}",
    
    "inertia": "n = 0; if (numKeys > 0){n = nearestKey(time).index; if (key(n).time > time){n--;}} if (n > 0){t = time - key(n).time; v = velocityAtTime(key(n).time - 0.001); sub(v*t, [0,0,0]);} else {value}",
    
    "time_offset": "t = time - inPoint; timeOffset = 0.5; value.valueAtTime(t - timeOffset)",
    
    "loop_in_out": "loopIn('cycle', 0); loopOut('cycle', 0)"
  },
  
  "workflow_optimization": {
    "pre_compose": {
      "naming": "descriptive_prefixed",
      "move_attributes": "into_comp",
      "open_new_comp": false
    },
    
    "layer_organization": {
      "color_code": true,
      "naming_convention": "Type_Description_Number",
      "use_shy_layers": true,
      "lock_completed": true
    },
    
    "keyboard_shortcuts": {
      "preview": "0_numpad",
      "trim_in": "alt_[",
      "trim_out": "alt_]",
      "add_marker": "*_numpad",
      "time_remap": "ctrl_alt_t"
    }
  }
}
