{
  "version": "1.0-AE",
  "last_updated": "2026-01-04",
  "target_software": "Adobe After Effects 2024/2025",
  "schema_version": "motion_advanced",
  
  "meta": {
    "total_styles": 6,
    "motion_optimized": true,
    "render_ready": true,
    "export_formats": ["MOV", "MP4", "PNG_SEQ", "GIF"],
    "fps_presets": [24, 30, 60]
  },
  
  "styles": [
    {
      "style_id": "cyberpunk_motion_v1",
      "name": "Cyberpunk Motion Graphics",
      "description": "High-tech dystopian motion design with neon glows and digital glitches",
      "version": "1.0",
      "complexity": "high",
      "render_preset": "ProRes 422 HQ",
      
      "metadata": {
        "best_for": ["title_sequences", "lower_thirds", "hud_interfaces", "tech_reveals"],
        "duration_range": [3, 30],
        "recommended_fps": 30
      },
      
      "composition": {
        "default_size": [1920, 1080],
        "pixel_aspect": 1.0,
        "frame_rate": 30,
        "duration": 10,
        "background_color": [0.039, 0.039, 0.059]
      },
      
      "color_system": {
        "mode": "RGB",
        "ae_color_format": "0-1_range",
        "primary": [
          {"name": "Cyan Neon", "ae_rgb": [0, 0.941, 1.0], "hex": "#00F0FF"},
          {"name": "Magenta Shock", "ae_rgb": [1.0, 0, 0.333], "hex": "#FF0055"},
          {"name": "Purple Haze", "ae_rgb": [0.690, 0.149, 1.0], "hex": "#B026FF"},
          {"name": "Acid Green", "ae_rgb": [0.224, 1.0, 0.078], "hex": "#39FF14"}
        ],
        "background": [
          {"name": "Deep Black", "ae_rgb": [0.039, 0.039, 0.059], "hex": "#0A0A0F"},
          {"name": "Dark Void", "ae_rgb": [0.102, 0.102, 0.125], "hex": "#1A1A20"}
        ]
      },
      
      "typography_ae": {
        "title_style": {
          "fonts": ["Orbitron-Bold", "Audiowide-Regular", "RajdhaniBold"],
          "fallback": "Impact",
          "size_range": [80, 200],
          "tracking": 50,
          "case": "UPPERCASE",
          "alignment": "center",
          
          "animation": {
            "in_method": "glitch_reveal",
            "in_duration": 1.0,
            "out_method": "fade_out",
            "out_duration": 0.5
          },
          
          "effects": [
            {
              "name": "Glow",
              "plugin": "ADBE Glo2",
              "params": {
                "threshold": 50,
                "radius": 50,
                "intensity": 100
              }
            },
            {
              "name": "Stroke",
              "plugin": "ADBE Stroke",
              "params": {
                "brush_size": 3,
                "paint_style": "on_transparent"
              }
            }
          ]
        },
        
        "subtitle_style": {
          "fonts": ["Roboto-Regular", "IBMPlexSans"],
          "size_range": [24, 48],
          "tracking": 0,
          "opacity": 0.8
        }
      },
      
      "shape_layers": {
        "geometric_elements": {
          "shapes": ["rectangle", "hexagon", "circle", "line"],
          "fill_type": "solid",
          "stroke_width": [2, 5, 8],
          "corner_roundness": 0,
          
          "animation_patterns": [
            {
              "name": "scale_pulse",
              "property": "scale",
              "expression": "s = [100,100]; freq = 2; amp = 10; w = wiggle(freq, amp); [s[0]+w[0], s[1]+w[1]]"
            },
            {
              "name": "rotation_loop",
              "property": "rotation",
              "expression": "loopOut('cycle')"
            }
          ]
        },
        
        "lines_tech": {
          "width_range": [1, 5],
          "style": "solid",
          "cap": "square",
          "join": "miter",
          
          "trim_paths": {
            "animate": true,
            "start_offset": 0,
            "end_offset": 100,
            "duration": 1.5
          }
        }
      },
      
      "effects_library": {
        "glow_setup": {
          "effect": "ADBE Glo2",
          "glow_threshold": 50,
          "glow_radius": 50,
          "glow_intensity": 100,
          "composite": "behind"
        },
        
        "glitch_displacement": {
          "effect": "ADBE Displacement Map",
          "max_horizontal": 50,
          "max_vertical": 50,
          "expression": "wiggle(20, 100)"
        },
        
        "chromatic_aberration": {
          "method": "channel_shift",
          "red_offset": [5, 0],
          "blue_offset": [-5, 0],
          "blend_mode": "screen"
        },
        
        "scanlines": {
          "effect": "ADBE Venetian Blinds",
          "direction": 0,
          "width": 2,
          "feather": 0,
          "transition": 100,
          "blend_mode": "screen",
          "opacity": 15
        },
        
        "light_rays": {
          "effect": "CC Light Rays",
          "intensity": 75,
          "center": "center_comp"
        }
      },
      
      "animation_presets": {
        "text_reveal_glitch": {
          "duration": 1.0,
          "steps": [
            {"time": 0.0, "opacity": 0, "position_offset": [0, 50]},
            {"time": 0.3, "opacity": 100, "position_offset": [0, 0]},
            {"time": 0.35, "glitch": true},
            {"time": 0.4, "glitch": false}
          ]
        },
        
        "shape_draw_on": {
          "duration": 1.5,
          "trim_paths": {
            "start": [0, 0],
            "end": [0, 100]
          },
          "easing": "ease_out"
        },
        
        "pulse_loop": {
          "property": "scale",
          "keyframes": [
            {"time": 0, "value": [100, 100]},
            {"time": 0.5, "value": [110, 110]},
            {"time": 1.0, "value": [100, 100]}
          ],
          "loop": "cycle"
        }
      },
      
      "camera_setup": {
        "use_3d": false,
        "depth_of_field": false,
        "preset": "2d_motion"
      },
      
      "blend_modes": {
        "glow_layers": "screen",
        "overlay_textures": "overlay",
        "light_elements": "add"
      }
    },
    
    {
      "style_id": "minimal_corporate_v1",
