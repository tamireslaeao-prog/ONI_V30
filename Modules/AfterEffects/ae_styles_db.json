      "version": "1.0",
      "complexity": "low",
      
      "composition": {
        "default_size": [1920, 1080],
        "frame_rate": 30,
        "duration": 8,
        "background_color": [1.0, 1.0, 1.0]
      },
      
      "color_system": {
        "mode": "RGB",
        "primary": [
          {"name": "Corporate Blue", "ae_rgb": [0, 0.322, 0.647], "hex": "#0052A5"},
          {"name": "Professional Gray", "ae_rgb": [0.302, 0.302, 0.302], "hex": "#4D4D4D"}
        ]
      },
      
      "typography_ae": {
        "title_style": {
          "fonts": ["HelveticaNeue-Light", "Gotham-Light"],
          "size_range": [60, 120],
          "tracking": 0,
