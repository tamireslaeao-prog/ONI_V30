        {
            "check": "preview_resolution",
            "prompt": "Resolução de preview",
            "expected": "Full para final, Half/Quarter para edição",
            "fix_if_wrong": "Ctrl+J para alternar",
            "importance": "medium",
            "verification": "Botão de resolução no painel Composition"
