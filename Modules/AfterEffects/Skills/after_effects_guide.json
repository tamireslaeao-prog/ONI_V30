        {
            "check": "layer_quality",
            "prompt": "Verifique qualidade das layers",
            "expected": "Best quality para render final",
            "fix_if_wrong": "Ctrl+U para alternar qualidade",
            "importance": "high",
            "verification": "Ícone de qualidade ao lado da layer"
        },
        {
            "check": "work_area",
            "prompt": "Verifique área de trabalho na timeline",
            "expected": "Work area cobre o trecho desejado",
            "fix_if_wrong": "Pressione B para início e N para fim",
