    "pre_animation_checklist": [
        {
            "check": "composition_settings",
            "prompt": "Verifique configurações da composição",
            "expected": "Resolução, framerate e duração corretos",
            "fix_if_wrong": "Ctrl+K para abrir settings",
            "importance": "critical",
            "verification": "Info panel ou composition settings"
