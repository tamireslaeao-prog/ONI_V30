        {
            "check": "audio_preview",
            "prompt": "Preview de áudio configurado",
            "expected": "Duração adequada para sincronização",
            "fix_if_wrong": "Edit > Preferences > Previews",
            "importance": "medium",
            "verification": "Preferences panel"
