          }
        },
        
        "body": {
          "fonts": ["Arial", "Helvetica", "Myriad Pro"],
          "size_range": [10, 18],
          "line_spacing": 1.4,
          "justify": "left",
          "hyphenation": false
        },
        
        "technical": {
          "fonts": ["Courier", "Courier New", "Monaco"],
          "size_range": [8, 12],
          "tracking": 20,
          "use_for": ["serial_numbers", "codes", "technical_data"]
