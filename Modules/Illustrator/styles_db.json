            "from": 100,
            "to": 0
          }
        }
      },
      
      "effects_illustrator": {
        "stylize": {
          "outer_glow": {
            "enabled": true,
            "mode": "Screen",
            "opacity": 75,
            "blur": 15,
            "color": "match_object"
          },
          "inner_glow": {
            "enabled": false
          },
          "drop_shadow": {
            "enabled": false
          }
